{
  "name": "pi8",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "extensions",
    "!extensions/*.test.ts",
    "!extensions/**/*.test.ts",
    "!extensions/__fixtures__/",
    "!extensions/test-support/",
    "index.ts",
    "README.md"
  ],
  "description": "Benchmark-aware auto model router for Pi — routes per-turn and per-subagent-role to the best available model based on live intelligence, speed, and cost data.",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "pi8",
    "llm",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "author": "",
  "exports": {
    ".": "./index.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run tsc",
    "test": "vitest run",
    "check": "npm run tsc && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.86.0",
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "typebox": "1.3.7"
  }
}
