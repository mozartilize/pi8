{
  "name": "pi8",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "extensions",
    "!extensions/*.test.ts",
    "!extensions/**/*.test.ts",
    "!extensions/test-support/",
    "index.ts",
    "README.md"
  ],
  "description": "Benchmark-aware model selection for Pi main-session turns based on intelligence, speed, and cost data.",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "pi8",
    "llm",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "author": "",
  "exports": {
    ".": "./index.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.eval.json",
    "build": "tsc",
    "prepublishOnly": "npm run tsc",
    "test": "vitest run",
    "test:candidate-policy": "PI8_POLICY_VERSION=cheapest-sufficient vitest run extensions",
    "measure:pool": "PI8_POOL_MEASURE=1 timeout 1800 vitest run extensions/routing/optimization/pool-measurement.test.ts",
    "freeze:pool": "node scripts/freeze-real-pool.mjs",
    "replay:local": "PI8_LOCAL_REPLAY=1 timeout 900 vitest run extensions/serve/context-replay.test.ts",
    "check": "npm run tsc && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.87.0",
    "@earendil-works/pi-ai": ">=0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "fast-check": "^4.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "highs": "1.15.3",
    "minisearch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "unbash": "4.0.11"
  }
}
